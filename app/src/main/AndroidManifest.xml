            </intent-filter>
        </activity-alias>
        <activity-alias android:name=".Launch_hrvatska" android:targetActivity=".MainActivity" android:exported="true" android:enabled="false"
            android:icon="@mipmap/ic_g_hrvatska_a" android:label="Glossa Pocket">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias android:name=".Launch_gammaclassic" android:targetActivity=".MainActivity" android:exported="true" android:enabled="false"
            android:icon="@mipmap/ic_g_gammaclassic_a" android:label="Glossa Pocket">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias android:name=".Launch_gammalambda" android:targetActivity=".MainActivity" android:exported="true" android:enabled="false"
            android:icon="@mipmap/ic_g_gammalambda_a" android:label="Glossa Pocket">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias android:name=".Launch_georgian" android:targetActivity=".MainActivity" android:exported="true" android:enabled="false"
            android:icon="@mipmap/ic_g_georgian_a" android:label="Glossa Pocket">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity android:name=".Reader" android:exported="false" android:configChanges="orientation|screenSize|keyboardHidden" />
        <activity android:name=".Player" android:exported="false" android:screenOrientation="fullSensor"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <provider android:name=".FilesProvider" android:authorities="com.batchmine.pocket.files"
            android:exported="false" android:grantUriPermissions="true" />
    </application>
</manifest>
