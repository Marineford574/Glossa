<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="com.ichi2.anki.permission.READ_WRITE_DATABASE" />

    <queries>
        <package android:name="com.ichi2.anki" />
        <intent><action android:name="android.intent.action.TTS_SERVICE" /></intent>
    </queries>

    <application
        android:name=".App"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="Glossa Pocket"
        android:largeHeap="true"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar"
        android:usesCleartextTraffic="true">

        <activity android:name=".MainActivity" android:exported="true" android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <!-- "Glossa" in the text-selection menu of any app, and Share → Glossa -->
            <intent-filter android:label="Look up in Glossa">
                <action android:name="android.intent.action.PROCESS_TEXT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>
        <!-- The icon on the launcher: one of these is switched on (Settings → Look → App icon); Icons.java switches them. -->
        <activity-alias android:name=".Launch" android:targetActivity=".MainActivity" android:exported="true" android:enabled="true"
            android:icon="@mipmap/ic_launcher" android:label="Glossa Pocket">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias android:name=".Launch_illuminated" android:targetActivity=".MainActivity" android:exported="true" android:enabled="false"
            android:icon="@mipmap/ic_g_illuminated_a" android:label="Glossa Pocket">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias android:name=".Launch_oldgold" android:targetActivity=".MainActivity" android:exported="true" android:enabled="false"
            android:icon="@mipmap/ic_g_oldgold_a" android:label="Glossa Pocket">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias android:name=".Launch_swashred" android:targetActivity=".MainActivity" android:exported="true" android:enabled="false"
            android:icon="@mipmap/ic_g_swashred_a" android:label="Glossa Pocket">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias android:name=".Launch_cooknight" android:targetActivity=".MainActivity" android:exported="true" android:enabled="false"
            android:icon="@mipmap/ic_g_cooknight_a" android:label="Glossa Pocket">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias android:name=".Launch_gaira" android:targetActivity=".MainActivity" android:exported="true" android:enabled="false"
            android:icon="@mipmap/ic_g_gaira_a" android:label="Glossa Pocket">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias android:name=".Launch_gairared" android:targetActivity=".MainActivity" android:exported="true" android:enabled="false"
            android:icon="@mipmap/ic_g_gairared_a" android:label="Glossa Pocket">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias android:name=".Launch_glagring" android:targetActivity=".MainActivity" android:exported="true" android:enabled="false"
            android:icon="@mipmap/ic_g_glagring_a" android:label="Glossa Pocket">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias android:name=".Launch_baska" android:targetActivity=".MainActivity" android:exported="true" android:enabled="false"
            android:icon="@mipmap/ic_g_baska_a" android:label="Glossa Pocket">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias android:name=".Launch_sahovnica" android:targetActivity=".MainActivity" android:exported="true" android:enabled="false"
            android:icon="@mipmap/ic_g_sahovnica_a" android:label="Glossa Pocket">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
